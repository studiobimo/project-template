{
    "$schema": "https://www.schemastore.org/claude-code-settings.json",
    "autoCompactEnabled": true,
    "autoCompactWindow": 500000,
    "attribution": {
        "pr": "",
        "commit": "",
        "sessionUrl": false
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.devtools/scripts/agent-guard.sh",
                        "timeout": 60
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.devtools/scripts/stray-java.sh || true",
                        "timeout": 15
                    }
                ]
            }
        ]
    }
}
