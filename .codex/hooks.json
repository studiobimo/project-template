{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '\"$(git rev-parse --show-toplevel)/.devtools/scripts/agent-guard.sh\"'",
            "statusMessage": "Checking PR size and branch name rules",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
